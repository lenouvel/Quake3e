// bridge.fbs — Quake3e <-> Python AI/monitoring bridge protocol (FlatBuffers).
// Replaces the line-delimited JSON. Framing: 4-byte little-endian length prefix
// followed by a plain (non-size-prefixed) FlatBuffer whose root is `Message`.
// C side generated by flatcc; Python side by flatc (--python). Field layout is the
// versioned wire contract — mirror of the old JSON keys.

namespace UrtBridge;

struct Vec3 { x:float; y:float; z:float; }

// Enriched player/entity snapshot (mirror of Bridge_WriteEntityJson).
table Entity {
  id:int;
  ent_type:int;        // JSON "type"
  flags:int;
  origin:Vec3;
  velocity:Vec3;
  angles:Vec3;
  viewangles:Vec3;
  health:int;
  armor:int;
  weapon:int;
  ammo:int;
  client_num:int;      // JSON "clientNum"
  groundent:int;
  event:int;
  event_parm:int;      // JSON "eventParm"
  powerups:int;
  modelindex:int;
  modelindex2:int;
  legs_anim:int;       // JSON "legsAnim"
  torso_anim:int;      // JSON "torsoAnim"
  rays:[float];        // 16 geometric sensor ray distances (units)
  ground:float;
  ceiling:float;
  slick:int;
}

table Event {
  event_type:int;      // JSON "type"
  time:int;
  ent:int;
  other:int;
  value:int;
  origin:Vec3;
}

// Engine -> clients, every frame.
table State {
  time:int;
  mapname:string;
  entities:[Entity];
  events:[Event];
}

// Engine -> all clients, after each GAME_INIT.
table GameInit {}

// Client -> engine: one bot command (mirror of bridge_bot_cmd_t / Bridge_ProcessCommand).
table Command {
  client:int;
  move:Vec3;           // normalized movement direction
  speed:float;
  view:Vec3;           // desired view angles
  attack:int;
  jump:int;
  crouch:int;
  sprint:int;
  use:int;
  weapon:int;
  respawn:int;
}

// Client -> engine: registration handshake.
table Register {
  is_ai:bool;          // true = AI controller for `bot`, false = monitor only
  bot:int;
}

union Payload { State, GameInit, Command, Register }

table Message { payload:Payload; }

root_type Message;
